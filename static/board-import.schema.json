{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "board-import.schema.json",
	"title": "Board App import",
	"description": "Tables and relations to import into a board. Either one page (an object with \"tables\") or several pages ({ \"pages\": [...] }). Positions are optional: tables without x/y are laid out automatically.",
	"oneOf": [
		{ "$ref": "#/$defs/page" },
		{
			"type": "object",
			"required": ["pages"],
			"properties": {
				"$schema": { "type": "string" },
				"pages": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/page" } }
			},
			"additionalProperties": false
		}
	],
	"$defs": {
		"page": {
			"type": "object",
			"required": ["tables"],
			"properties": {
				"$schema": { "type": "string" },
				"page": { "type": "string", "minLength": 1, "description": "Page title. Defaults to \"Imported\"." },
				"size": {
					"description": "Page size. Defaults to the smallest paper size the tables fit on.",
					"oneOf": [
						{
							"type": "string",
							"enum": [
								"A4 landscape", "A4 portrait", "A3 landscape", "A3 portrait",
								"A2 landscape", "A2 portrait", "A1 landscape", "A1 portrait"
							]
						},
						{
							"type": "object",
							"required": ["width", "height"],
							"properties": {
								"width": { "type": "number", "minimum": 300 },
								"height": { "type": "number", "minimum": 200 }
							},
							"additionalProperties": false
						}
					]
				},
				"x": { "type": "number", "description": "Page position on the board (used when importing as a new page)." },
				"y": { "type": "number" },
				"tables": { "type": "array", "items": { "$ref": "#/$defs/table" } },
				"relations": { "type": "array", "items": { "$ref": "#/$defs/relation" } }
			},
			"additionalProperties": false
		},
		"table": {
			"type": "object",
			"required": ["name", "columns"],
			"properties": {
				"name": { "type": "string", "minLength": 1, "description": "Unique within the page." },
				"x": { "type": "number", "description": "Position relative to the page's top-left corner. Give both x and y, or neither." },
				"y": { "type": "number" },
				"columns": { "type": "array", "items": { "$ref": "#/$defs/column" } }
			},
			"additionalProperties": false
		},
		"column": {
			"type": "object",
			"required": ["name"],
			"properties": {
				"name": { "type": "string", "minLength": 1 },
				"type": { "type": "string", "description": "Free text: conceptual, logical or physical (e.g. \"Text\", \"integer\", \"varchar(255)\")." },
				"key": { "type": "string", "enum": ["", "PK", "FK", "PK+FK"] },
				"pk": { "type": "boolean", "description": "Alternative to \"key\"." },
				"fk": { "type": "boolean", "description": "Alternative to \"key\"." }
			},
			"additionalProperties": false
		},
		"relation": {
			"type": "object",
			"required": ["from", "to"],
			"properties": {
				"from": { "$ref": "#/$defs/columnRef" },
				"to": { "$ref": "#/$defs/columnRef" },
				"fromCardinality": { "$ref": "#/$defs/cardinality", "description": "Defaults to zero-or-many." },
				"toCardinality": { "$ref": "#/$defs/cardinality", "description": "Defaults to one." }
			},
			"additionalProperties": false
		},
		"columnRef": {
			"type": "string",
			"pattern": "^.+\\.[^.]+$",
			"description": "\"table.column\" on the same page. The part after the last dot is the column, so table names may contain dots (\"sales.order.id\")."
		},
		"cardinality": {
			"type": "string",
			"enum": ["one", "zero-or-one", "one-or-many", "zero-or-many", "1", "0..1", "1..*", "0..*"]
		}
	}
}
